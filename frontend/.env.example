AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
AUTH_MICROSOFT_ENTRA_ID_SCOPE=openid profile email api://<core-api-app-client-id>/access_as_user
CORE_API_BASE_URL=https://core-api.example.org

# Existing workspace sign-in and BFF routing; public values are baked into its build.
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
NEXT_PUBLIC_AZURE_AD_TENANT_ID=
NEXT_PUBLIC_AZURE_AD_API_SCOPE=api://<core-api-app-client-id>/access_as_user
DASHBOARD_BFF_URL=https://core-api.example.org

# Development only. Ignored when NODE_ENV=production.
ALLOW_LOCAL_AUTH=false
